{
  "name": "review-panel-mcp",
  "version": "0.1.0",
  "description": "MCP server that sends any of your GitHub repos to three AI judges (Claude for workflows, Gemini for UI/UX, Codex for code structure) and returns one scored report.",
  "type": "module",
  "bin": {
    "review-panel-mcp": "server.js"
  },
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "license": "MIT"
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251014.0",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "wrangler": "4.45.0"
  }
}
